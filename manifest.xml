<?xml version="1.0"?>
<!--
    Casio AE1200 ("World Time") inspired watch face for the
    Garmin Forerunner 165 / 165 Music.

    type="watchface" -> this is a watch face, not an app/widget.
    No permissions are required: alarm count comes from
    System.getDeviceSettings(), which needs no permission.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        entry="CasioWorldTimeApp"
        id="a1b2c3d4e5f64789a0b1c2d3e4f50617"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="3.2.0"
        name="@Strings.AppName"
        type="watchface">
        <iq:products>
            <!-- Forerunner 165 and 165 Music -->
            <iq:product id="fr165"/>
            <iq:product id="fr165m"/>
        </iq:products>
        <iq:permissions/>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
    </iq:application>
</iq:manifest>
